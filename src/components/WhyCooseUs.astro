---
import Carousel_Item_1  from './Carousel_Item_1.astro';
import Carousel_Item_2 from './Carousel_Item_2.astro';
import Carousel_Item_3 from './Carousel_Item_3.astro';
---

<section id="elegirnos" class="py-16 md:py-20 md:px-6 bg-[#0a1b1b]">
  <!-- Contenedor principal relativo para que los botones absolutos se posicionen respecto a él -->
  <div id="indicators-carousel" class="relative w-full max-w-7xl mx-auto pb-8 select-none">
      
      <!-- Carousel wrapper con eventos táctiles añadidos -->
      <div id="carousel-wrapper" class="relative w-full overflow-hidden px-2 md:px-12 cursor-grab active:cursor-grabbing">
          
          <!-- Item 1 -->
          <div class="item active w-full" data-carousel="1">
              <div class="text-center">
                <div class="inline-flex items-center text-xl md:text-2xl gap-2 py-1 px-4 rounded-full bg-[#142e2e] text-lime-400 border border-[#1f4646]">
                  ¿Por qué elegirnos?
                </div>
              </div>
              <div class="w-full mt-4">
                <Carousel_Item_1 />
              </div>
          </div>

          <!-- Item 2 -->
          <div class="item hidden w-full text-white text-center" data-carousel="2">
              <div class="text-center">
                <div class="inline-flex items-center text-xl md:text-2xl gap-2 py-1 px-4 rounded-full bg-[#142e2e] text-lime-400 border border-[#1f4646]">
                  ¿Por qué elegirnos?
                </div>
              </div>
              <div class="w-full mt-4">
                <Carousel_Item_2 />
              </div>
          </div>
          
          <!-- Item 3 -->
          <div class="item hidden w-full text-white text-center" data-carousel="3">
              <div class="text-center">
                <div class="inline-flex items-center text-xl md:text-2xl gap-2 py-1 px-4 rounded-full bg-[#142e2e] text-lime-400 border border-[#1f4646]">
                  Testimonios
                </div>
              </div>
              <div class="w-full mt-4">
                <Carousel_Item_3 />
              </div>
          </div>
      </div>

      <!-- Slider controls (Absolutos, centrados verticalmente a los costados) -->
      <button id="prev" type="button" class="absolute top-1/2 -translate-y-1/2 left-0 z-30 flex items-center justify-center p-2 cursor-pointer group focus:outline-none">
          <span class="inline-flex items-center justify-center w-10 h-10 md:w-12 md:h-12 rounded-full bg-gray-800/80 border border-slate-700/50 group-hover:bg-lime-400 transition-all duration-300 shadow-lg">
              <svg class="w-5 h-5 md:w-6 md:h-6 text-white group-hover:text-black" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m15 19-7-7 7-7"/></svg>
          </span>
      </button>

      <button id="next" type="button" class="absolute top-1/2 -translate-y-1/2 right-0 z-30 flex items-center justify-center p-2 cursor-pointer group focus:outline-none">
          <span class="inline-flex items-center justify-center w-10 h-10 md:w-12 md:h-12 rounded-full bg-gray-800/80 border border-slate-700/50 group-hover:bg-lime-400 transition-all duration-300 shadow-lg">
              <svg class="w-5 h-5 md:w-6 md:h-6 text-white group-hover:text-black" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m9 5 7 7-7 7"/></svg>
          </span>
      </button>

      <!-- Slider indicators (Debajo del contenido pero dentro del wrapper principal) -->
      <div class="flex justify-center space-x-3 mt-8">
          <button type="button" class="indicator w-3 h-3 rounded-full bg-lime-400 transition-colors duration-300" aria-current="true" aria-label="Slide 1" data-carousel-slide-to="0"></button>
          <button type="button" class="indicator w-3 h-3 rounded-full bg-gray-700 transition-colors duration-300" aria-current="false" aria-label="Slide 2" data-carousel-slide-to="1"></button>
          <button type="button" class="indicator w-3 h-3 rounded-full bg-gray-700 transition-colors duration-300" aria-current="false" aria-label="Slide 3" data-carousel-slide-to="2"></button>
      </div>

  </div>

  <div class="text-center mt-12">
    <a href="#cta" class="inline-block bg-lime-400 text-[#0a1b1b] font-bold py-3 px-8 rounded-full hover:bg-lime-300 transition duration-300 shadow-lg text-sm sm:text-base">
      Contrata tu asistente virtual hoy
    </a>
  </div>
</section>

<style>
  /* --- Animaciones de Desplazamiento Lateral --- */
  @keyframes outToLeft {
    to { opacity: 0; transform: translateX(-40px); }
  }
  @keyframes outToRight {
    to { opacity: 0; transform: translateX(40px); }
  }
  @keyframes inFromRight {
    from { opacity: 0; transform: translateX(40px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes inFromLeft {
    from { opacity: 0; transform: translateX(-40px); }
    to { opacity: 1; transform: translateX(0); }
  }

  .animate-outToLeft { animation: outToLeft 0.35s forwards ease-in-out; }
  .animate-outToRight { animation: outToRight 0.35s forwards ease-in-out; }
  .animate-inFromRight { animation: inFromRight 0.35s forwards ease-in-out; }
  .animate-inFromLeft { animation: inFromLeft 0.35s forwards ease-in-out; }

  .item {
    display: none;
  }
  .item.active {
    display: block;
  }
</style>

<script>
  const nextBtn = document.getElementById("next");
  const prevBtn = document.getElementById("prev");
  const items = document.querySelectorAll(".item");
  const indicators = document.querySelectorAll(".indicator");
  const wrapper = document.getElementById("carousel-wrapper");
  
  let currentIndex = 0;
  const totalItems = items.length;
  let isAnimating = false;

  // Variables para gestos táctiles (Swipe)
  let touchStartX = 0;
  let touchEndX = 0;
  const minSwipeDistance = 40;

  function updateCarousel(newIndex: number, direction: 'next' | 'prev') {
    if (isAnimating) return;
    isAnimating = true;

    const currentItem = items[currentIndex];
    const nextItem = items[newIndex];

    const outClass = direction === 'next' ? 'animate-outToLeft' : 'animate-outToRight';
    const inClass = direction === 'next' ? 'animate-inFromRight' : 'animate-inFromLeft';

    // 1. Salida del elemento actual
    currentItem.classList.add(outClass);
    
    // 2. Preparar el siguiente elemento
    nextItem.classList.remove('hidden');
    nextItem.classList.add('active', inClass);

    updateIndicators(newIndex);

    // 3. Limpiar clases al terminar la animación (350ms)
    setTimeout(() => {
      currentItem.classList.remove('active', outClass);
      currentItem.classList.add('hidden');
      
      nextItem.classList.remove(inClass);
      
      currentIndex = newIndex;
      isAnimating = false;
    }, 350);
  }

  function updateIndicators(index: number) {
    indicators.forEach((ind, idx) => {
      if (idx === index) {
        ind.classList.remove('bg-gray-700');
        ind.classList.add('bg-lime-400');
        ind.setAttribute('aria-current', 'true');
      } else {
        ind.classList.remove('bg-lime-400');
        ind.classList.add('bg-gray-700');
        ind.setAttribute('aria-current', 'false');
      }
    });
  }

  nextBtn?.addEventListener("click", () => {
    const newIndex = (currentIndex + 1) % totalItems;
    updateCarousel(newIndex, 'next');
  });

  prevBtn?.addEventListener("click", () => {
    const newIndex = (currentIndex - 1 + totalItems) % totalItems;
    updateCarousel(newIndex, 'prev');
  });

  indicators.forEach((indicator, index) => {
    indicator.addEventListener("click", () => {
      if (index !== currentIndex) {
        const direction = index > currentIndex ? 'next' : 'prev';
        updateCarousel(index, direction);
      }
    });
  });

  // --- Soporte táctil con la misma animación ---
  wrapper?.addEventListener("touchstart", (e) => {
    touchStartX = e.changedTouches[0].screenX;
  }, { passive: true });

  wrapper?.addEventListener("touchend", (e) => {
    touchEndX = e.changedTouches[0].screenX;
    handleSwipe();
  }, { passive: true });

  function handleSwipe() {
    const distance = touchEndX - touchStartX;
    if (Math.abs(distance) < minSwipeDistance) return;

    if (distance < 0) {
      // Deslizó hacia la izquierda -> Siguiente (efecto 'next')
      const newIndex = (currentIndex + 1) % totalItems;
      updateCarousel(newIndex, 'next');
    } else {
      // Deslizó hacia la derecha -> Anterior (efecto 'prev')
      const newIndex = (currentIndex - 1 + totalItems) % totalItems;
      updateCarousel(newIndex, 'prev');
    }
  }
</script>