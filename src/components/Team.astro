---
const team = [
  {
    name: "Ricardo Marquez",
    role: "Founder & CEO",
    img:
      "/Agents/ricardo.webp",
  },
  {
    name: "Pablo Vergara",
    role: "COO",
    img:
      "/Agents/pablo.webp",
  },
  {
    name: "Simoney Albornoz",
    role: "Head of Operations",
    img:
      "/Agents/simoney.jpeg",
  },
  {
    name: "Bernardo Heredia",
    role: "Sales Manager",
    img:
      "/Agents/Bernie.webp",
  },
];


---

<section id="equipo" class="py-20 px-6 bg-[#0a1b1b]">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 py-1 px-4 rounded-full bg-[#142e2e] text-lime-400 text-sm border border-[#1f4646] mb-4">
        Nuestro Equipo
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-white">Conoce a nuestro equipo de expertos</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
      {team.map((member) => (
        <div class="team-card group relative overflow-hidden rounded-3xl">
          <!-- imgn -->
          <img src={member.img} alt={member.name} class="w-full h-100 object-cover transition-transform duration-500 group-hover:scale-110" />

          <!-- Info -->
          <div class="mt-6 text-center">
            <h3 class="text-xl font-bold text-white">{member.name}</h3>
            <p class="text-slate-400 group-hover:text-lime-400 font-bold">{member.role}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>