---
const testimonials = [
  {
    quote: "Gracias a Ricardo, no sabia que seria tan facil, llegan clientes en automatico, solo me ocupo de atenderlos, tengo mas energia y los ingresos subieron en correlacion con los meses anteriores.",
    name: "Carennys serrano",
    role: "Dentista",
    title: "",
    img: "/Agents/Carennys serrano.jpeg"
  },
  {
    quote: "Estos chicos son increibles, no dejo de recomendarlos",
    name: "Dan",
    role: "Propietario de E-comerce",
    title: "",
    img: "/Agents/Dan.jpeg"
  },
  {
    quote: "Bastante contento con las cantidad de leads que agendan tanto en ingles como español, mi equipo se encarga, Me encanta.",
    name: "Mark Brenner",
    role: "Agente de Bienes Raices",
    title: "",
    img: "/Agents/mark brenner.jpeg"
  },
  {
    quote: "Un poco gracioso, me tomo 2 semanas aprender cada cosa de mi negocio y pense en delegarlo muchas veces pensando que le tomaria mucho mas a alguien externo pero los asistentes virtuales estan contentos y emocionados por trabajar, solo requirieron 1 semana.",
    name: "Raul",
    role: "Automatización de IA",
    title: "",
    img: "/Agents/Raul.jpeg"
  },
  {
    quote: "La silla oclos ejecutiva no deja de venderse y la tienda no para de recibir nuevos pedidos, todo fluye mejor que nunca.",
    name: "Sebas Fuks",
    role: "Propietario de E-comerce",
    title: "",
    img: "/Agents/sebas fuks.jpeg"
  },
  {
    quote: `Bastante contento con lo que Ben y su equipo han hecho, cada nuevo negocio requiere una persona especifica y nunca habia sido tan facil, lo consiguen con la experiencia que busco en menos de 72H 

Totalmente recomendados, Gracias Ben y el equipo de yourserviceva`,
    name: "Lorne",
    role: "CEO",
    title: "",
    img: "/Agents/lorne.jpeg"
  },
];
---

<section id="testimonios" class="py-20 px-6">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 py-1 px-4 rounded-full bg-[#142e2e] text-lime-400 text-sm border border-[#1f4646] mb-4">
        Testimonios
      </div>
      <h2 class="text-4xl md:text-5xl font-bold text-[#0a1b1b]">Lo que dicen nuestros clientes sobre nuestras Asistentes Virtuales</h2>
    </div>

    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5 rounded-3xl overflow-hidden h-[400px]">
        <img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?q=80&w=800" class="w-full h-full object-cover" alt="Asistente virtual trabajando" />
      </div>

      <div class="lg:col-span-7 flex flex-col md:flex-row items-center gap-8">
        
        <!-- Componente con efecto de barrido de luz -->
        <div class="example-2 relative rounded-[2rem] overflow-hidden bg-[#142e2e] flex-1 w-full">
          <div class="before-light"></div>
          
          <div class="inner relative z-10 p-8">
            <div id="test-card" class="transition-opacity duration-300">
              <div class="text-lime-400 mb-4 text-xl">★★★★★</div>
              <h3 id="test-title" class="text-white font-bold text-2xl mb-4">{testimonials[0].title}</h3>
              <p id="test-text" class="text-slate-100 text-lg mb-8 leading-relaxed italic">"{testimonials[0].quote}"</p>
              
              <div class="flex items-center gap-4">
                <img id="test-img" src={testimonials[0].img} class="w-12 h-12 rounded-full border-2 border-lime-400 object-cover" alt="Cliente" />
                <div>
                  <div id="test-name" class="text-white font-bold text-xl">{testimonials[0].name}</div>
                  <div id="test-role" class="text-lg text-lime-400">{testimonials[0].role}</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar de avatares -->
        <div class="flex md:flex-col flex-row gap-4">
          {testimonials.map((t, index) => (
            <button 
              class={`avatar-btn w-12 h-12 rounded-full overflow-hidden border-2 transition shadow-lg ${index === 0 ? 'border-lime-400 scale-105' : 'border-transparent opacity-70 hover:opacity-100 hover:border-lime-400'}`}
              data-index={index}
              aria-label={`Ver testimonio de ${t.name}`}
            >
              <img src={t.img} class="w-full h-full object-cover" alt={t.name} />
            </button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .example-2 {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .example-2 .inner {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 2px;
    background: #142e2e;
    border-radius: 2rem;
  }

  .before-light {
    content: "";
    display: block;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0) 0%,
      rgb(157, 248, 37) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    height: 680px;  
    width: 180px;
    position: absolute;
    animation: rotate 4s linear infinite;
    z-index: 0;
    top: -150px;
    transform-origin: top center;
  }

  @keyframes rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  const testimonials = [
  {
    quote: "Gracias a Ricardo, no sabia que seria tan facil, llegan clientes en automatico, solo me ocupo de atenderlos, tengo mas energia y los ingresos subieron en correlacion con los meses anteriores.",
    name: "Carennys serrano",
    role: "Dentista",
    title: "",
    img: "/Agents/Carennys serrano.jpeg"
  },
  {
    quote: "Estos chicos son increibles, no dejo de recomendarlos",
    name: "Dan",
    role: "Propietario de E-comerce",
    title: "",
    img: "/Agents/Dan.jpeg"
  },
  {
    quote: "Bastante contento con las cantidad de leads que agendan tanto en ingles como español, mi equipo se encarga, Me encanta.",
    name: "Mark Brenner",
    role: "Agente de Bienes Raices",
    title: "",
    img: "/Agents/mark brenner.jpeg"
  },
  {
    quote: "Un poco gracioso, me tomo 2 semanas aprender cada cosa de mi negocio y pense en delegarlo muchas veces pensando que le tomaria mucho mas a alguien externo pero los asistentes virtuales estan contentos y emocionados por trabajar, solo requirieron 1 semana.",
    name: "Raul",
    role: "Automatización de IA",
    title: "",
    img: "/Agents/Raul.jpeg"
  },
  {
    quote: "La silla oclos ejecutiva no deja de venderse y la tienda no para de recibir nuevos pedidos, todo fluye mejor que nunca.",
    name: "Sebas Fuks",
    role: "Propietario de E-comerce",
    title: "",
    img: "/Agents/sebas fuks.jpeg"
  },
  {
    quote: `Bastante contento con lo que Ben y su equipo han hecho, cada nuevo negocio requiere una persona especifica y nunca habia sido tan facil, lo consiguen con la experiencia que busco en menos de 72H 

Totalmente recomendados, Gracias Ben y el equipo de yourserviceva`,
    name: "Lorne",
    role: "CEO",
    title: "",
    img: "/Agents/lorne.jpeg"
  },
];

  const card = document.getElementById('test-card');
  const title = document.getElementById('test-title');
  const text = document.getElementById('test-text');
  const name = document.getElementById('test-name');
  const role = document.getElementById('test-role');
  const img = document.getElementById('test-img');
  const buttons = document.querySelectorAll('.avatar-btn');

  buttons.forEach((button, index) => {
    button.addEventListener('click', () => {
      const t = testimonials[index];
      
      // Actualizar clases activas en los avatares
      buttons.forEach(btn => {
        btn.classList.remove('border-lime-400', 'scale-105');
        btn.classList.add('border-transparent', 'opacity-70');
      });
      button.classList.remove('border-transparent', 'opacity-70');
      button.classList.add('border-lime-400', 'scale-105');

      // Transición suave de la tarjeta
      if (card) {
        card.style.opacity = '0';
        setTimeout(() => {
          if (title) title.innerText = t.title;
          if (text) text.innerText = `"${t.quote}"`;
          if (name) name.innerText = t.name;
          if (role) role.innerText = t.role;
          if (img) (img as HTMLImageElement).src = t.img;
          card.style.opacity = '1';
        }, 300);
      }
    });
  });
</script>