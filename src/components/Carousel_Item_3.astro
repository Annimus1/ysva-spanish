---
const testimonios = [
  {
    quote: "Gracias a Ricardo, no sabia que seria tan facil, llegan clientes en automatico, solo me ocupo de atenderlos, tengo mas energia y los ingresos subieron en correlacion con los meses anteriores.",
    name: "Carennys serrano",
    role: "Dentista",
    title: "",
    img: "/Agents/Carennys serrano.jpeg"
  },
  {
    quote: "Bastante feliz con las cantidad de leads que agendan tanto en ingles como español, mi equipo se encarga, Me encanta.",
    name: "Mark Brenner",
    role: "Agente de Bienes Raices",
    title: "",
    img: "/Agents/mark brenner.jpeg"
  },
  {
    quote: "Un poco gracioso, me tomo 2 semanas aprender cada cosa de mi negocio y pense en delegarlo muchas veces pensando que le tomaria mucho mas a alguien externo pero los asistentes virtuales estan contentos y emocionados por trabajar, solo requirieron 1 semana.",
    name: "Raul",
    role: "Automatización de IA",
    title: "",
    img: "/Agents/Raul.jpeg"
  },
  {
    quote: "La silla oclos ejecutiva no deja de venderse y la tienda no para de recibir nuevos pedidos, todo fluye mejor que nunca.",
    name: "Sebas Fuks",
    role: "Propietario de E-comerce",
    title: "",
    img: "/Agents/sebas fuks.jpeg"
  },
];
---

<div id="testimonios" class="py-12 px-4 bg-[#0a1b1b] w-[95vw] md:w-full">
  <div class="w-full max-w-7xl mx-auto bg-[#142e2e]/40 rounded-3xl md:rounded-[2rem] p-6 sm:p-8 md:p-12 border border-slate-700/40 shadow-2xl">
    
    <!-- Cabecera -->
    <div class="text-center mb-8 md:mb-10 max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl text-lime-400 font-semibold uppercase tracking-wider mb-3 md:mb-4">
        Lo que dicen nuestros clientes
      </h2>
      <p class="text-slate-100 text-base sm:text-lg md:text-xl font-medium leading-relaxed">
        Descubre cómo nuestros asistentes virtuales han transformado la operativa diaria de diferentes negocios.
      </p>
    </div>

    <!-- Tarjetas de Testimonios (Grid 2x2) usando bucle -->
    <div class="grid md:grid-cols-2 gap-6 mb-4">
      {testimonios.map((item) => (
        <div class="bg-[#0a1b1b]/90 p-6 md:p-8 rounded-2xl border border-slate-700/50 flex flex-col justify-between shadow-lg">
          <p class="text-slate-300 text-base sm:text-lg italic leading-relaxed mb-6">
            "{item.quote}"
          </p>
          <div class="flex items-center gap-4">
            <!-- Avatar con espacio reservado e iniciales de respaldo -->
            <div class="relative w-12 h-12 rounded-full bg-lime-400/10 border-2 border-lime-400/40 overflow-hidden flex items-center justify-center text-lime-400 shrink-0">
              <img src={item.img} alt={item.name} class="w-full h-full object-cover relative z-10" onerror="this.style.display='none'" />
            </div>
            <div>
              <p class="text-lime-400 font-bold text-lg">{item.name}</p>
              <p class="text-slate-200 text-sm">{item.role}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</div>